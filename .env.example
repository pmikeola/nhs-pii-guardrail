# Anthropic API key — required
ANTHROPIC_API_KEY=sk-ant-...

# Per-team API keys for red team access — required
# Format: teamname:key,teamname:key  (comma-separated, no spaces around colons)
# Generate keys with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Example: GUARDRAIL_API_KEYS=red1:abc123xyz,red2:def456uvw
GUARDRAIL_API_KEYS=red1:your-key-here,red2:your-key-here

# Admin key for downloading logs — required, only you need this
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=your-admin-key-here
